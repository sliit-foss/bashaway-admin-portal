{
  "name": "bashaway-admin-portal",
  "version": "2.1.0",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier --write --cache \"**/*.{js,jsx,mjs,ts,tsx,md,mdx}\"",
    "lint": "eslint . --fix --cache --report-unused-disable-directives",
    "preview": "vite preview",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@reduxjs/toolkit": "2.15.0",
    "@sliit-foss/bashaway-ui": "0.12.4",
    "async-mutex": "0.5.0",
    "chart.js": "4.6.1",
    "framer-motion": "14.14.0",
    "jwt-decode": "4.0.0",
    "lodash": "4.18.1",
    "lucide-react": "1.76.0",
    "markdown-it": "15.0.3",
    "moment-timezone": "0.6.6",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-loader-spinner": "8.0.2",
    "react-markdown": "10.1.0",
    "react-markdown-editor-lite": "1.4.2",
    "react-redux": "9.3.1",
    "react-router-dom": "7.18.6",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "vite": "8.3.8"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-loading-skeleton@3.3.1": "patches/react-loading-skeleton@3.3.1.patch"
    },
    "overrides": {
      "@sliit-foss/bashaway-ui>@radix-ui/react-accordion": "1.3.1",
      "@sliit-foss/bashaway-ui>@radix-ui/react-alert-dialog": "1.2.1",
      "@sliit-foss/bashaway-ui>@radix-ui/react-toast": "1.3.1",
      "@sliit-foss/bashaway-ui>@radix-ui/react-tooltip": "1.4.1",
      "@sliit-foss/bashaway-ui>framer-motion": "$framer-motion",
      "@sliit-foss/bashaway-ui>lodash": "$lodash",
      "@sliit-foss/bashaway-ui>react": "$react",
      "@sliit-foss/bashaway-ui>react-dom": "$react-dom",
      "@sliit-foss/bashaway-ui>react-icons": "$react-icons",
      "@sliit-foss/bashaway-ui>react-loader-spinner": "$react-loader-spinner",
      "@sliit-foss/bashaway-ui>react-redux": "$react-redux",
      "@sliit-foss/bashaway-ui>react-router-dom": "$react-router-dom",
      "@sliit-foss/bashaway-ui>tailwind-merge": "$tailwind-merge",
      "react-markdown-editor-lite>nanoid": "5.1.16"
    },
    "ignoredBuiltDependencies": [
      "lefthook"
    ]
  }
